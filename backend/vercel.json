{
    "version": 2,
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "15mb"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "methods": [
                "OPTIONS"
            ],
            "headers": {
                "Access-Control-Allow-Origin": "*",
                "Access-Control-Allow-Methods": "GET, POST, PUT, OPTIONS",
                "Access-Control-Allow-Headers": "*"
            },
            "status": 204
        },
        {
            "src": "/(.*)",
            "dest": "main.py"
        }
    ],
    "functions": {
        "main.py": {
            "maxDuration": 60,
            "memory": 1024
        }
    }
}